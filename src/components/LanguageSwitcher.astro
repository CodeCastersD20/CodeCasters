---

<div id="lang-switcher" class="flex gap-1 bg-white/5 border border-white/10 rounded-full p-1">
  <button
    id="lang-es"
    class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full transition-all"
    data-lang="es"
  >
    ES
  </button>
  <button
    id="lang-en"
    class="px-3 py-1 text-xs font-bold uppercase tracking-wider rounded-full transition-all"
    data-lang="en"
  >
    EN
  </button>
</div>

<style>
  #lang-switcher button {
    color: #9ca3af;
    background-color: transparent;
  }

  #lang-switcher button:hover {
    color: white;
  }

  #lang-switcher button.active {
    background-color: #4ade80;
    color: black;
  }
</style>

<script is:inline>
  function initLanguageSwitcher() {
    const langButtons = document.querySelectorAll('[data-lang]');
    const currentLang = localStorage.getItem('site-language') || 'es';

    // Set initial active button
    langButtons.forEach(button => {
      const lang = button.getAttribute('data-lang');
      if (lang === currentLang) {
        button.classList.add('active');
      } else {
        button.classList.remove('active');
      }
    });

    // Add click handlers
    langButtons.forEach(button => {
      button.addEventListener('click', () => {
        const lang = button.getAttribute('data-lang');
        localStorage.setItem('site-language', lang);
        location.reload();
      });
    });
  }

  // Run when DOM is ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLanguageSwitcher);
  } else {
    initLanguageSwitcher();
  }
</script>
