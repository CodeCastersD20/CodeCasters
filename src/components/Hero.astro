---
---
<section class="relative min-h-[80vh] flex flex-col items-center justify-center overflow-hidden py-20 px-4">
  <!-- Background Effects -->
  <div class="absolute inset-0 z-0">
    <div class="absolute top-1/4 -left-20 w-96 h-96 bg-brand-purple/20 rounded-full blur-[120px]"></div>
    <div class="absolute bottom-1/4 -right-20 w-96 h-96 bg-brand-green/10 rounded-full blur-[120px]"></div>
  </div>

  <div class="relative z-10 text-center max-w-4xl mx-auto">
    <!-- Logo Placeholder / Icon -->
    <div class="mb-8 inline-block relative">
      <div class="absolute inset-0 bg-brand-green blur-2xl opacity-20 animate-pulse"></div>
      <svg width="120" height="120" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="relative z-10">
        <path d="M50 5L10 25V75L50 95L90 75V25L50 5Z" stroke="currentColor" stroke-width="2" class="text-brand-green" />
        <path d="M50 20L25 32.5V67.5L50 80L75 67.5V32.5L50 20Z" stroke="currentColor" stroke-width="1" class="text-brand-purple" />
        <text x="50" y="58" text-anchor="middle" font-family="monospace" font-size="24" fill="currentColor" class="text-brand-green font-bold">20</text>
      </svg>
    </div>

    <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-4 bg-clip-text text-transparent bg-gradient-to-b from-white to-gray-400">
      Code<span class="text-brand-green">Casters</span>
    </h1>
    
    <div class="flex justify-center mb-8">
      <p class="text-xl md:text-2xl text-brand-green font-mono opacity-90 overflow-hidden whitespace-nowrap border-r-4 border-brand-green w-0 animate-typewriter">
        &gt; soluciones_limpias, eficientes y escalables_
      </p>
    </div>

    <style>
      .animate-typewriter {
        animation: 
          typing 3.5s steps(45, end) forwards,
          blink-caret .75s step-end infinite;
      }

      @keyframes typing {
        from { width: 0 }
        to { width: 100% }
      }

      @keyframes blink-caret {
        from, to { border-color: transparent }
        50% { border-color: #4ade80; }
      }
    </style>
    
    <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-10">
      Ingenieros de la Universidad Tecnológica de Hermosillo. Forjando el futuro del software con precisión técnica y un toque de magia arcana.
    </p>

    <div class="flex flex-wrap justify-center gap-4">
      <a href="#contacto" class="px-8 py-3 bg-brand-green text-black font-bold rounded-md hover:bg-white transition-colors">
        Lanzar Proyecto
      </a>
      <a href="#equipo" class="px-8 py-3 border border-gray-700 hover:border-brand-purple text-white font-medium rounded-md transition-all">
        Conoce al Gremio
      </a>
    </div>
  </div>

  <!-- Scroll Down indicator -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2 animate-bounce opacity-50">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 13l5 5 5-5M7 6l5 5 5-5"/></svg>
  </div>
</section>
