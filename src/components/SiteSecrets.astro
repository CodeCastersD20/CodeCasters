<div id="secret-boot" class="secret-boot" hidden aria-live="assertive">
  <div class="secret-boot__noise" aria-hidden="true"></div>
  <main class="secret-boot__content">
    <p class="secret-boot__code">404</p>
    <h1>PAGE_NOT_FOUND</h1>
    <p>El recurso solicitado no existe.</p>
    <p class="secret-boot__status">HTTP_ERROR_404</p>
  </main>
</div>

<div id="secret-terminal" class="secret-terminal" hidden role="dialog" aria-modal="true" aria-labelledby="secret-terminal-title">
  <section class="secret-terminal__window">
    <header class="secret-terminal__header">
      <div class="secret-terminal__lights" aria-hidden="true"><i></i><i></i><i></i></div>
      <p id="secret-terminal-title">codecasters@core:~</p>
      <button id="secret-terminal-close" type="button" aria-label="Cerrar terminal">×</button>
    </header>
    <div id="secret-terminal-output" class="secret-terminal__output" aria-live="polite"></div>
    <form id="secret-terminal-form" class="secret-terminal__form" autocomplete="off">
      <label for="secret-terminal-input">guest@codecasters:~$</label>
      <input id="secret-terminal-input" type="text" spellcheck="false" autocomplete="off" aria-label="Comando" />
    </form>
  </section>
</div>

<div id="site-erased-screen" class="site-erased-screen" hidden aria-hidden="true"></div>

<div id="konami-notice" class="konami-notice" hidden aria-live="polite">
  <strong>SDRX RUNTIME DESBLOQUEADO</strong>
  <span>La realidad visual ha sido alterada.</span>
</div>

<style is:global>
  .secret-boot {
    position: fixed;
    inset: 0;
    z-index: 2147483647;
    display: grid;
    place-items: center;
    overflow: hidden;
    background: #050507;
    color: #e5e7eb;
    font-family: 'JetBrains Mono', monospace;
  }

  .secret-boot[hidden], .secret-terminal[hidden], .konami-notice[hidden], .site-erased-screen[hidden] { display: none; }

  .secret-boot__content { position: relative; z-index: 1; padding: 2rem; text-align: center; }
  .secret-boot__code { margin: 0; color: #ff3131; font-size: clamp(6rem, 24vw, 16rem); font-weight: 800; line-height: .8; letter-spacing: -.09em; }
  .secret-boot h1 { margin: 2rem 0 .75rem; font-size: clamp(1.2rem, 4vw, 2rem); }
  .secret-boot p { color: #94a3b8; }
  .secret-boot__status { font-size: .75rem; letter-spacing: .2em; }
  .secret-boot__noise { position: absolute; inset: -50%; opacity: .06; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E"); animation: secret-noise .18s steps(2) infinite; }
  .secret-boot.is-breaking { animation: secret-shake .24s infinite; }
  .secret-boot.is-breaking .secret-boot__code { color: #00d4ff; text-shadow: 8px 0 #bc13fe, -8px 0 #ff3131; animation: secret-glitch .12s infinite; }
  .secret-boot.is-breaking h1 { color: #fff; text-shadow: 3px 0 #ff3131, -3px 0 #00d4ff; }
  .secret-boot.is-leaving { opacity: 0; transition: opacity .45s ease; }

  .secret-terminal { position: fixed; inset: 0; width: 100vw; height: 100dvh; z-index: 2147483600; display: grid; place-items: center; margin: 0; padding: 1rem; background: rgb(0 0 0 / .76); backdrop-filter: blur(8px); font-family: 'JetBrains Mono', monospace; }
  .secret-terminal__window { width: min(720px, 100%); height: min(520px, 78vh); display: grid; grid-template-rows: auto 1fr auto; overflow: hidden; border: 1px solid rgb(0 212 255 / .45); border-radius: 12px; background: rgb(3 7 10 / .97); box-shadow: 0 0 60px rgb(0 212 255 / .16), 0 24px 80px rgb(0 0 0 / .65); color: #d1fae5; }
  .secret-terminal__header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: .65rem .85rem; border-bottom: 1px solid rgb(255 255 255 / .1); background: #111318; }
  .secret-terminal__header p { margin: 0; color: #94a3b8; font-size: .75rem; }
  .secret-terminal__header button { justify-self: end; border: 0; background: transparent; color: #94a3b8; cursor: pointer; font-size: 1.4rem; line-height: 1; }
  .secret-terminal__lights { display: flex; gap: .4rem; }
  .secret-terminal__lights i { width: 10px; height: 10px; border-radius: 50%; background: #ff5f57; }
  .secret-terminal__lights i:nth-child(2) { background: #febc2e; }
  .secret-terminal__lights i:nth-child(3) { background: #28c840; }
  .secret-terminal__output { overflow-y: auto; padding: 1.2rem; font-size: clamp(.72rem, 2vw, .9rem); line-height: 1.65; white-space: pre-wrap; }
  .secret-terminal__line { margin: 0 0 .45rem; }
  .secret-terminal__line--command { color: #00d4ff; }
  .secret-terminal__line--error { color: #ff6b6b; }
  .secret-terminal__line--accent { color: #bc78ff; }
  .secret-terminal__form { display: flex; gap: .6rem; padding: .9rem 1.2rem; border-top: 1px solid rgb(255 255 255 / .08); color: #4ade80; font-size: clamp(.72rem, 2vw, .9rem); }
  .secret-terminal__form input { min-width: 0; flex: 1; border: 0; outline: 0; background: transparent; color: #f8fafc; font: inherit; caret-color: #00d4ff; }

  .site-erased-screen { position: fixed; inset: 0; z-index: 2147483647; background: #000; }
  body.site-erased > :not(.site-erased-screen) { visibility: hidden !important; }
  html.site-restoring body > :not(.site-erased-screen, script, style) { transform-origin: center; animation: old-tv-on 1.15s cubic-bezier(.19, 1, .22, 1) both; }
  html.site-restoring::after { content: ''; position: fixed; inset: 0; z-index: 2147483646; pointer-events: none; background: white; animation: old-tv-flash 1.15s ease-out both; }

  .konami-notice { position: fixed; z-index: 2147483500; right: 1rem; bottom: 1rem; display: grid; gap: .2rem; max-width: min(360px, calc(100vw - 2rem)); padding: 1rem 1.2rem; border: 1px solid #00d4ff; border-radius: 10px; background: rgb(5 5 8 / .94); box-shadow: 0 0 35px rgb(188 19 254 / .3); color: white; font-family: 'JetBrains Mono', monospace; animation: konami-enter .35s ease-out; }
  .konami-notice strong { color: #00d4ff; font-size: .8rem; }
  .konami-notice span { color: #94a3b8; font-size: .7rem; }
  html.konami-runtime::after { content: ''; position: fixed; inset: 0; z-index: 2147483400; pointer-events: none; background: repeating-linear-gradient(0deg, transparent 0 3px, rgb(0 212 255 / .035) 3px 4px); backdrop-filter: hue-rotate(0deg); animation: runtime-overlay 6s linear infinite; }

  @keyframes secret-noise { to { transform: translate3d(3%, -2%, 0); } }
  @keyframes secret-shake { 0%, 100% { transform: translate(0); } 25% { transform: translate(-1px, 1px); } 50% { transform: translate(1px, -1px); } 75% { transform: translate(-1px, 0); } }
  @keyframes secret-glitch { 50% { transform: skewX(8deg) translateX(-5px); filter: blur(1px); } }
  @keyframes konami-enter { from { opacity: 0; transform: translateY(20px); } }
  @keyframes runtime-overlay { to { backdrop-filter: hue-rotate(360deg); } }
  @keyframes old-tv-on {
    0% { opacity: 0; transform: scaleX(.01) scaleY(.002); filter: brightness(8); }
    32% { opacity: 1; transform: scaleX(1) scaleY(.012); filter: brightness(5); }
    58% { transform: scaleX(1) scaleY(1.04); filter: brightness(1.8) contrast(1.4); }
    72% { transform: scaleX(1.015) scaleY(.97); }
    100% { opacity: 1; transform: scale(1); filter: none; }
  }
  @keyframes old-tv-flash {
    0% { opacity: 1; transform: scaleY(.003); }
    35% { opacity: .8; transform: scaleY(.008); }
    60%, 100% { opacity: 0; transform: scaleY(1); }
  }

  @media (prefers-reduced-motion: reduce) {
    .secret-boot, .secret-boot *, html.konami-runtime::after, .konami-notice, html.site-restoring body > *, html.site-restoring::after { animation: none !important; }
  }
</style>

<script is:inline>
  (() => {
    if (window.__sdrxSecretsLoaded) return;
    window.__sdrxSecretsLoaded = true;

    const boot = document.getElementById('secret-boot');
    const terminal = document.getElementById('secret-terminal');
    const terminalOutput = document.getElementById('secret-terminal-output');
    const terminalForm = document.getElementById('secret-terminal-form');
    const terminalInput = document.getElementById('secret-terminal-input');
    const terminalClose = document.getElementById('secret-terminal-close');
    const konamiNotice = document.getElementById('konami-notice');
    const erasedScreen = document.getElementById('site-erased-screen');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const commandHistory = [];
    let historyIndex = 0;

    // Keep viewport overlays outside any transformed page container.
    document.documentElement.append(terminal, erasedScreen, konamiNotice, boot);

    console.log('%cALTO. ZONA RESTRINGIDA.', 'color:#ff3131;font:700 24px monospace;text-shadow:2px 2px #00d4ff');
    console.log('%c¿Qué haces aquí? Esta parte no estaba incluida en el recorrido.', 'color:#00d4ff;font:14px monospace');
    console.log('%cSi alguien te pidió pegar código en esta consola, no lo hagas. Podría darle acceso a tu información.', 'color:#fbbf24;font:13px monospace');
    console.log('%cYa que llegaste hasta aquí: Alt + Shift + T abre una entrada que no está en el menú.', 'color:#bc78ff;font:12px monospace');

    const addLine = (text, kind = '') => {
      const line = document.createElement('p');
      line.className = `secret-terminal__line${kind ? ` secret-terminal__line--${kind}` : ''}`;
      line.textContent = text;
      terminalOutput.appendChild(line);
      terminalOutput.scrollTop = terminalOutput.scrollHeight;
    };

    const openTerminal = () => {
      if (!terminal.hidden) return;
      terminal.hidden = false;
      document.body.style.overflow = 'hidden';
      if (!terminalOutput.childElementCount) {
        addLine('CodeCasters hidden shell [v1.0.0]', 'accent');
        addLine('Conexión no autorizada detectada. Curiosidad aceptada.');
        addLine("Escribe 'help' para listar los comandos disponibles.");
      }
      requestAnimationFrame(() => terminalInput.focus());
    };

    const closeTerminal = () => {
      terminal.hidden = true;
      document.body.style.overflow = '';
    };

    const eraseSite = () => {
      addLine('Permisos elevados. Eliminando /* ...', 'error');
      setTimeout(() => {
        closeTerminal();
        erasedScreen.hidden = false;
        document.body.classList.add('site-erased');
        document.body.style.overflow = 'hidden';

        setTimeout(() => {
          erasedScreen.hidden = true;
          document.body.classList.remove('site-erased');
          document.documentElement.classList.add('site-restoring');
          document.body.style.overflow = '';
          setTimeout(() => document.documentElement.classList.remove('site-restoring'), reducedMotion ? 100 : 1250);
        }, 5000);
      }, 650);
    };

    const commands = {
      help() { addLine('Comandos: help, about, team, sdrx, projects, status, clear, exit'); },
      about() { addLine('CodeCasters: ingeniería, software y una cantidad cuestionable de café.'); },
      team() { addLine('Accediendo al equipo...'); closeTerminal(); location.hash = 'equipo'; },
      sdrx() { addLine('Redirigiendo a SDRX Digital Runtime eXperience...', 'accent'); setTimeout(() => { location.href = '/sdrx'; }, 500); },
      projects() { addLine('Proyectos detectados: SDRX-Dots, SDRX-Beat, SDRX-Pax y CodeCasters.'); },
      status() { addLine(`runtime: ONLINE | path: ${location.pathname} | secrets: CLASSIFIED`); },
      clear() { terminalOutput.replaceChildren(); },
      exit() { closeTerminal(); }
    };

    terminalForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const raw = terminalInput.value.trim();
      terminalInput.value = '';
      if (!raw) return;
      if (commandHistory.at(-1) !== raw) commandHistory.push(raw);
      historyIndex = commandHistory.length;
      addLine(`guest@codecasters:~$ ${raw}`, 'command');
      const command = raw.toLowerCase().replace(/\s+/g, ' ');
      if (command === 'rm -rf /*') {
        addLine('rm: no puedes eliminar /*: permiso denegado. No eres administrador.', 'error');
      } else if (command === 'sudo rm -rf /*') {
        eraseSite();
      } else if (command === 'sudo') {
        addLine('sudo: hace falta un comando. Los privilegios no sustituyen una intención.', 'accent');
      } else if (command.startsWith('sudo ')) {
        addLine(`[sudo] acceso temporal concedido, pero '${raw.slice(5)}' no está disponible aquí.`, 'accent');
      } else if (commands[command]) commands[command]();
      else addLine(`command not found: ${raw}. Prueba 'help'.`, 'error');
    });

    terminalClose.addEventListener('click', closeTerminal);
    terminal.addEventListener('click', (event) => { if (event.target === terminal) closeTerminal(); });
    terminalInput.addEventListener('keydown', (event) => {
      if (!commandHistory.length || (event.key !== 'ArrowUp' && event.key !== 'ArrowDown')) return;
      event.preventDefault();
      if (event.key === 'ArrowUp') historyIndex = Math.max(0, historyIndex - 1);
      else historyIndex = Math.min(commandHistory.length, historyIndex + 1);
      terminalInput.value = historyIndex === commandHistory.length ? '' : commandHistory[historyIndex];
      requestAnimationFrame(() => terminalInput.setSelectionRange(terminalInput.value.length, terminalInput.value.length));
    });

    const konami = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
    let konamiIndex = 0;

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const isTyping = target instanceof HTMLInputElement || target instanceof HTMLTextAreaElement || target?.isContentEditable;

      if (event.key === 'Escape' && !terminal.hidden) {
        closeTerminal();
        return;
      }

      if (!isTyping && event.altKey && event.shiftKey && event.code === 'KeyT') {
        event.preventDefault();
        openTerminal();
      }

      const expected = konami[konamiIndex];
      if (event.key.toLowerCase() === expected.toLowerCase()) {
        konamiIndex += 1;
        if (konamiIndex === konami.length) {
          konamiIndex = 0;
          document.documentElement.classList.add('konami-runtime');
          konamiNotice.hidden = false;
          setTimeout(() => { konamiNotice.hidden = true; }, 5000);
        }
      } else {
        konamiIndex = event.key.toLowerCase() === konami[0].toLowerCase() ? 1 : 0;
      }
    });

    const random = new Uint32Array(1);
    crypto.getRandomValues(random);
    if ((random[0] & 0x0fff) === 0) {
    // if (true) {
      boot.hidden = false;
      document.body.style.overflow = 'hidden';
      setTimeout(() => {
        boot.classList.add('is-breaking');
        boot.querySelector('h1').textContent = 'AQUÍ NO TENEMOS ESOS ERRORES';
        boot.querySelector('.secret-boot__status').textContent = 'SDRX_RECOVERY_PROTOCOL: ACTIVE';
        boot.querySelector('.secret-boot__content > p:nth-of-type(2)').textContent = 'Restaurando la realidad...';
      }, 1000);
      setTimeout(() => {
        boot.classList.remove('is-breaking');
        boot.classList.add('is-leaving');
      }, reducedMotion ? 2900 : 3700);
      setTimeout(() => {
        boot.hidden = true;
        boot.classList.remove('is-leaving');
        document.body.style.overflow = '';
      }, reducedMotion ? 3200 : 4200);
    }
  })();
</script>
