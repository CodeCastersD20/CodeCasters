                Trabajando en <span class="text-white font-bold tracking-tight"><a href="https://kngura.com" target="_blank">Kngura</a></span>
            </p>

            <div class="flex flex-wrap gap-4">
                {socialLinks.map(s => (
                    <a href={s.url} target="_blank" class={`px-4 py-2 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-purple/50 hover:bg-sdrx-purple/10 transition-all text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-white`}>
                        {s.name}
                    </a>
                ))}
            </div>
          </div>

          <!-- Status Board -->
          <div class="w-full lg:w-80 space-y-6">
            <div class="p-6 bg-white/5 border border-white/10 rounded-3xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-2">
                    <div class="w-2 h-2 rounded-full bg-sdrx-sky animate-pulse"></div>
                </div>
                <h3 class="text-xs font-black text-slate-500 uppercase tracking-widest mb-4">En_Línea_Status</h3>
                <div class="mb-4 text-center lg:text-left">
                    <p class="text-2xl font-bold text-white font-mono" id="hermosillo-time">00:00:00</p>
                    <p class="text-[10px] text-slate-500 font-mono italic">Hermosillo, MX</p>
                </div>
                <div class="p-3 bg-black/40 rounded-xl border border-white/5">
                    <p class="text-[10px] text-slate-400 mb-1 font-mono uppercase">Haciendo ahora:</p>
                    <p class="text-sm font-bold text-sdrx-sky" id="current-task">Procesando_...</p>
                </div>
                <div class="mt-4 pt-4 border-t border-white/5">
                    <p class="text-[10px] text-slate-500 uppercase font-bold">Discord</p>
                    <p class="text-sm text-slate-300">@{DISCORD_USERNAME}</p>
                </div>
            </div>

            <div class="p-6 bg-gradient-to-br from-sdrx-purple/10 to-transparent border border-sdrx-purple/20 rounded-3xl group text-center lg:text-left">
                <h3 class="text-[10px] font-black text-sdrx-purple uppercase tracking-widest mb-4 flex items-center justify-center lg:justify-start gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 18H2z"/></svg>
                    Steam_Session
                </h3>
                <div id="steam-status">
                    <p class="text-xs text-slate-400 italic">No detectado / Offline</p>
                </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SDRX-dots Spotlight -->
    <section id="sdrx-dots" class="py-10 md:py-24 px-4 relative z-10 bg-white/[0.01] border-y border-white/5 shadow-[inset_0_0_50px_rgba(188,19,254,0.05)]">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-5 gap-12 items-center mb-20">
