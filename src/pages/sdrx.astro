---
import SDRXLayout from '../layouts/SDRXLayout.astro';

const birthDate = new Date('2005-08-20T00:00:00');

const projects = [
  {
    title: "SDRX-pax",
    desc: "Instalador de paquetes interactivo en TUI para Arch Linux. Combina pacman y yay (AUR) en una única interfaz fzf ultrarrápida. Carga en <50ms usando Smart Caching.",
    tech: ["Rust", "fzf", "Pacman", "Yay"],
    link: "https://github.com/Sadrach34/SDRX-pax",
    color: "sdrx-sky"
  },
  {
    title: "SDRX-Beat",
    desc: "Reproductor de música para terminal (TUI) basado en mpv. Soporta archivos locales y streaming de YouTube/radio por internet sin interfaz gráfica. Gestión de sesiones y descargas integradas.",
    tech: ["Python", "mpv", "yt-dlp", "Curses"],
    link: "https://github.com/Sadrach34/SDRX-Beat",
    color: "sdrx-purple"
  }
];

const screenshots = [
  { src: "/assets/sdrx-dots/desktop-main.png", title: "Main Desktop" },
  { src: "/assets/sdrx-dots/dashboard.png", title: "Dashboard" },
  { src: "/assets/sdrx-dots/app_launcher.png", title: "App Launcher" },
  { src: "/assets/sdrx-dots/wallpaper-picker.png", title: "Wallpaper Picker" }
];

const socialLinks = [
  { name: "GitHub", url: "https://github.com/Sadrach34", color: "sdrx-sky" },
  { name: "Discord", url: "https://discord.com", username: "sadrach34", color: "sdrx-purple" },
  { name: "Instagram", url: "https://instagram.com", color: "sdrx-red" },
  { name: "YouTube", url: "https://youtube.com", color: "sdrx-red" },
  { name: "Reddit", url: "https://reddit.com", color: "orange-500" }
];

const games = ["Elden Ring", "Cyberpunk 2077", "Minecraft (Modded)", "Dungeons & Dragons", "Doom Eternal"];
const hyperfixations = ["Arch Linux Customization", "Rust Performance", "TUI Design", "High-fidelity Audio", "Keyboard Modding"];
const favoriteSongs = [
    { title: "Resonance", artist: "HOME" },
    { title: "After Dark", artist: "Mr.Kitty" },
    { title: "Virtual Insanity", artist: "Jamiroquai" }
];

const blogPosts = []; // Vacío por ahora
---

<SDRXLayout title="SDRX | Digital Runtime Experience">
  <main class="min-h-screen relative pb-20 overflow-x-hidden">
    <!-- Navbar -->
    <nav class="p-6 flex flex-col sm:flex-row justify-between items-center max-w-7xl mx-auto relative z-10 gap-4">
      <a href="/" class="text-sm font-mono text-slate-500 hover:text-sdrx-sky transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Volver a CodeCasters
      </a>
      <div class="px-4 py-1 bg-white/5 border border-white/10 rounded-full text-xs font-mono text-sdrx-sky">
        v2.4.0-stable
      </div>
    </nav>

    <!-- Header / Bio -->
    <section class="pt-10 md:pt-20 pb-20 px-4 relative">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
          <div class="flex-1">
            <div class="mb-8 p-1 w-fit bg-gradient-to-tr from-sdrx-sky via-sdrx-purple to-sdrx-red rounded-3xl rotate-2 shadow-2xl shadow-sdrx-sky/10">
                <img src="/assets/sdrx-dots/logo-sdrx.png" alt="SDRX Logo" class="w-32 h-32 object-cover rounded-[1.4rem] -rotate-2" />
            </div>
            <h1 class="text-6xl md:text-8xl font-black mb-6 tracking-tighter bg-clip-text text-transparent bg-gradient-to-b from-white to-slate-500">
                SDRX
            </h1>
            
            <p class="text-slate-300 text-xl md:text-2xl leading-relaxed max-w-3xl mb-10">
                Soy <span class="text-white font-bold tracking-tight">Sadrach Juan Diego Garcia Flores</span>, tengo <span class="text-sdrx-sky font-mono font-bold inline-block min-w-[12ch]" id="age-counter">20.00000000</span> años e <span class="text-sdrx-purple italic">Ingeniero en software multiplataforma</span>.
            </p>
            
            <div class="flex flex-wrap gap-4">
                {socialLinks.map(s => (
                    <a href={s.url} target="_blank" class={`px-4 py-2 bg-white/5 border border-white/10 rounded-xl hover:border-white/30 transition-all text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-white`}>
                        {s.name}
                    </a>
                ))}
            </div>
          </div>

          <!-- Status Board -->
          <div class="w-full lg:w-80 space-y-6">
            <div class="p-6 bg-white/5 border border-white/10 rounded-3xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-2">
                    <div class="w-2 h-2 rounded-full bg-sdrx-sky animate-pulse"></div>
                </div>
                <h3 class="text-xs font-black text-slate-500 uppercase tracking-widest mb-4">En_Línea_Status</h3>
                <div class="mb-4">
                    <p class="text-2xl font-bold text-white" id="hermosillo-time">00:00:00</p>
                    <p class="text-xs text-slate-500 font-mono italic">Hermosillo, MX</p>
                </div>
                <div class="p-3 bg-black/40 rounded-xl border border-white/5">
                    <p class="text-xs text-slate-400 mb-1 font-mono uppercase">Haciendo ahora:</p>
                    <p class="text-sm font-bold text-sdrx-sky" id="current-task">Procesando_...</p>
                </div>
                <div class="mt-4 pt-4 border-t border-white/5">
                    <p class="text-[10px] text-slate-500 uppercase font-bold">Discord</p>
                    <p class="text-sm text-slate-300">@sadrach34</p>
                </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SDRX-dots Spotlight -->
    <section class="py-10 md:py-24 px-4 relative z-10 bg-white/[0.01] border-y border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-5 gap-12 items-center mb-20">
          <div class="lg:col-span-2 text-center lg:text-left">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6 text-white tracking-tight">SDRX-dots</h2>
            <div class="h-1.5 w-24 bg-gradient-to-r from-sdrx-sky via-sdrx-purple to-sdrx-red mb-8 mx-auto lg:mx-0 rounded-full"></div>
            <p class="text-slate-400 leading-relaxed mb-10 text-base md:text-lg">
              Mi entorno de escritorio definitivo. Un ecosistema visualmente impactante construido sobre <strong>Arch Linux</strong> y <strong>Hyprland</strong>. 
            </p>
            
            <div class="grid grid-cols-2 gap-4 mb-10 text-left">
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-sky/30 transition-colors">
                    <h4 class="text-sdrx-sky font-bold text-[10px] uppercase mb-1">Widgets</h4>
                    <p class="text-slate-300 text-sm">Quickshell</p>
                </div>
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-purple/30 transition-colors">
                    <h4 class="text-sdrx-purple font-bold text-[10px] uppercase mb-1">Barra</h4>
                    <p class="text-slate-300 text-sm">Waybar</p>
                </div>
            </div>

            <a href="https://github.com/Sadrach34/SDRX-Dots" target="_blank" class="inline-flex items-center gap-4 px-8 py-4 bg-white text-black font-black rounded-2xl hover:bg-sdrx-sky transition-all transform hover:-translate-y-1">
                CLONAR ARTEFACTOS
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
            </a>
          </div>
          
          <div class="lg:col-span-3 grid grid-cols-2 gap-4">
             {screenshots.map((s, i) => (
                <div class={`group relative aspect-video bg-white/5 border border-white/10 rounded-2xl overflow-hidden ${i === 1 ? 'mt-8' : i === 2 ? '-mt-8' : ''}`}>
                    <img src={s.src} alt={s.title} class="w-full h-full object-cover opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                        <span class="text-xs font-mono text-sdrx-sky">{s.title}</span>
                    </div>
                </div>
             ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Terminal Projects (TUI) -->
    <section class="py-24 px-4 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16 text-center lg:text-left">
          <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Forjas de Terminal</h2>
          <p class="text-slate-400 max-w-2xl">Utilerías diseñadas para la eficiencia pura. Sin distracciones gráficas, solo rendimiento y control total.</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {projects.map(p => (
            <div class="group bg-black border border-white/10 hover:border-sdrx-sky/30 rounded-3xl p-8 transition-all relative overflow-hidden flex flex-col justify-between">
              <div class={`absolute top-0 right-0 w-32 h-32 opacity-0 group-hover:opacity-10 blur-3xl transition-opacity rounded-full bg-${p.color}`}></div>
              <div>
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-sdrx-sky transition-colors font-mono">{p.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-8">
                  {p.desc}
                </p>
                <div class="flex flex-wrap gap-2 mb-8">
                  {p.tech.map(t => (
                    <span class="text-[10px] uppercase tracking-widest font-bold px-2 py-1 bg-white/5 text-slate-300 border border-white/10 rounded">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
              <a href={p.link} target="_blank" class="inline-flex items-center gap-2 text-sm font-bold text-white hover:text-sdrx-sky transition-colors group">
                Explorar Código
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Personal Grids -->
    <section class="py-24 px-4 bg-white/[0.01] border-y border-white/5">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12 text-center md:text-left">
            <!-- Hyperfixations -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3">
                    <span class="w-1.5 h-6 bg-sdrx-purple rounded-full"></span>
                    Hiperfijaciones
                </h3>
                <ul class="space-y-3">
                    {hyperfixations.map(h => (
                        <li class="p-3 bg-white/5 border border-white/5 rounded-xl text-slate-300 text-sm hover:translate-x-1 transition-transform">
                            {h}
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Gaming -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3">
                    <span class="w-1.5 h-6 bg-sdrx-sky rounded-full"></span>
                    Campo de Batalla
                </h3>
                <div class="space-y-2">
                    {games.map(g => (
                        <div class="flex items-center justify-center md:justify-start gap-3 p-2 group">
                            <div class="w-1.5 h-1.5 rounded-full bg-slate-700 group-hover:bg-sdrx-sky transition-colors"></div>
                            <span class="text-slate-300 text-sm">{g}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Music -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3">
                    <span class="w-1.5 h-6 bg-sdrx-red rounded-full"></span>
                    Frecuencias
                </h3>
                <div class="space-y-4">
                    {favoriteSongs.map(s => (
                        <div class="flex items-center gap-4 p-3 bg-black/40 rounded-2xl border border-white/5 group hover:border-sdrx-red/30 transition-all text-left">
                            <div class="w-10 h-10 bg-slate-800 rounded-lg flex items-center justify-center shrink-0">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-sdrx-red"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
                            </div>
                            <div>
                                <p class="text-sm font-bold text-slate-200">{s.title}</p>
                                <p class="text-[10px] text-slate-500 uppercase tracking-tighter">{s.artist}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </section>

    <!-- Blog (Vacío) -->
    {blogPosts.length > 0 && (
        <section class="py-24 px-4">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold mb-12 text-center font-mono">&gt; BITACORA_</h2>
                <div class="space-y-8">
                    {blogPosts.map(post => (
                        <article class="p-8 bg-white/5 border border-white/10 rounded-[2rem] hover:border-sdrx-purple/30 transition-all group">
                            <time class="text-xs font-mono text-sdrx-purple mb-2 block">{post.date}</time>
                            <h3 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors">{post.title}</h3>
                            <p class="text-slate-400 text-sm mb-6 leading-relaxed">{post.snippet}</p>
                            <a href="#" class="text-xs font-black uppercase tracking-widest text-sdrx-sky hover:underline">Seguir leyendo_</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- Contact & Footer -->
    <section class="py-24 px-4 bg-sdrx-red/5 border-t border-sdrx-red/10">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-black mb-10 tracking-tight">¿NECESITAS UN HECHIZO DE CÓDIGO?</h2>
            <div class="inline-flex flex-col md:flex-row items-center gap-6 p-8 bg-black border border-white/10 rounded-[2.5rem] mb-12 shadow-2xl">
                <div class="flex flex-col items-center md:items-start">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.3em]">Direct_Access</p>
                    <a href="mailto:jdiego0805+dev@gmail.com" class="text-xl md:text-2xl font-bold text-sdrx-sky hover:text-white transition-colors">jdiego0805+dev@gmail.com</a>
                </div>
                <div class="h-px w-12 md:h-12 md:w-px bg-white/10"></div>
                <div class="flex flex-col items-center md:items-start">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.3em]">Discord_Node</p>
                    <span class="text-xl md:text-2xl font-bold text-sdrx-purple">sadrach34</span>
                </div>
            </div>
            <p class="text-slate-600 font-mono text-[10px] uppercase tracking-[0.5em]">SDRX © 2026 — DIGITAL RUNTIME EXPERIENCE</p>
        </div>
    </section>
  </main>
</SDRXLayout>

<script is:inline define:vars={{ birthDate }}>
    function updateAge() {
        const now = new Date();
        const diff = now - new Date(birthDate);
        const age = diff / (1000 * 60 * 60 * 24 * 365.25);
        const counter = document.getElementById('age-counter');
        if (counter) {
            counter.innerText = age.toFixed(9);
        }
    }

    function updateTime() {
        const hmoTime = new Intl.DateTimeFormat('es-MX', {
            timeZone: 'America/Hermosillo',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        }).format(new Date());
        
        const timeEl = document.getElementById('hermosillo-time');
        if (timeEl) timeEl.innerText = hmoTime;

        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Hermosillo',
            hour: 'numeric',
            minute: 'numeric',
            hour12: false
        });
        const parts = formatter.formatToParts(now);
        const hour = parseInt(parts.find(p => p.type === 'hour').value);
        const minute = parseInt(parts.find(p => p.type === 'minute').value);
        const decimalHour = hour + (minute / 60);
        
        let task = "Descansando_";
        if (decimalHour >= 7 && decimalHour < 8.5) task = "Despertando & Café_";
        else if (decimalHour >= 8.5 && decimalHour < 9) task = "En camino al trabajo_";
        else if (decimalHour >= 9 && decimalHour < 17) task = "Trabajando en KNGURA_";
        else if (decimalHour >= 17 && decimalHour < 18) task = "Llegando a base & Relax_";
        else if (decimalHour >= 18 && decimalHour < 20) task = "Estudiando Arcanos_";
        else if (decimalHour >= 20 && decimalHour < 22.5) task = "Ocio & Gaming_";
        else task = "Recargando_ (Sleeping)";

        const taskEl = document.getElementById('current-task');
        if (taskEl) taskEl.innerText = task;
    }

    setInterval(updateAge, 50);
    setInterval(updateTime, 1000);
    updateAge();
    updateTime();
</script>
