---

<SDRXLayout title="SDRX | Digital Runtime Experience">
  <!-- Navbar -->
  <nav class="p-3 md:p-6 fixed top-0 left-0 w-full z-50 bg-[#0a0a0c]/90 backdrop-blur-lg border-b border-white/5">
      <div class="max-w-7xl mx-auto flex justify-between items-center">
          <!-- Left: Back link (Always visible) -->
          <a href="/" class="text-xs md:text-sm font-mono text-slate-400 hover:text-sdrx-sky transition-colors flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
            <span data-i18n="sdrx.backLink">Ir a CodeCasters</span>
          </a>

          <!-- Desktop Navigation -->
          <div class="hidden md:flex items-center gap-6 text-xs font-mono uppercase tracking-widest">
            <a href="#sdrx-dots" class="text-slate-400 hover:text-sdrx-sky transition-colors">SDRX-dots</a>
            <a href="#terminal-projects" class="text-slate-400 hover:text-sdrx-sky transition-colors">Terminal</a>
            <a href="#personal" class="text-slate-400 hover:text-sdrx-sky transition-colors">Personal</a>
            <div class="text-slate-600">v1.6.0</div>
            
            <div class="flex gap-2 bg-white/5 border border-white/10 rounded-full p-1 ml-4">
              <button
                data-lang="es"
                class="px-3 py-1 text-[10px] font-bold uppercase rounded-full transition-all"
              >
                ES
              </button>
              <button
                data-lang="en"
                class="px-3 py-1 text-[10px] font-bold uppercase rounded-full transition-all"
              >
                EN
              </button>
            </div>
          </div>

          <!-- Mobile Menu Button -->
          <button
            id="mobile-menu-button"
            type="button"
            class="md:hidden grid place-items-center w-10 h-10 rounded-lg border border-white/10 bg-white/5 text-slate-400 hover:border-sdrx-sky/50 hover:text-sdrx-sky transition-colors"
            aria-label="Abrir menú"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <svg class="menu-open-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg class="menu-close-icon hidden" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
              <path d="M6 6l12 12M18 6L6 18" />
            </svg>
          </button>
      </div>

      <!-- Mobile Menu -->
      <div id="mobile-menu" class="hidden md:hidden pt-4" aria-hidden="true">
        <div class="flex flex-col gap-2 rounded-2xl border border-white/10 bg-[#0a0a0c]/fb p-4 shadow-2xl">
          <a href="#sdrx-dots" class="mobile-menu-link px-4 py-3 text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-sdrx-sky hover:bg-white/5 rounded-xl transition-colors">SDRX-dots</a>
          <a href="#terminal-projects" class="mobile-menu-link px-4 py-3 text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-sdrx-sky hover:bg-white/5 rounded-xl transition-colors">Terminal</a>
          <a href="#personal" class="mobile-menu-link px-4 py-3 text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-sdrx-sky hover:bg-white/5 rounded-xl transition-colors">Personal</a>
          
          <div class="flex items-center justify-between border-t border-white/10 mt-2 pt-4 px-4">
            <span class="text-[10px] font-mono uppercase tracking-widest text-slate-500">Idioma / v1.6.0</span>
            <div class="flex gap-2 bg-white/5 border border-white/10 rounded-full p-1">
              <button data-lang="es" class="px-3 py-1 text-[10px] font-bold uppercase rounded-full transition-all">ES</button>
              <button data-lang="en" class="px-3 py-1 text-[10px] font-bold uppercase rounded-full transition-all">EN</button>
            </div>
          </div>
        </div>
      </div>

      <!-- Combined Navigation Script -->
      <script is:inline>
        function initSdrxNav() {
          // Language Switcher Logic
          const langButtons = document.querySelectorAll('[data-lang]');
          const currentLang = localStorage.getItem('site-language') || 'es';

          langButtons.forEach(btn => {
            const lang = btn.getAttribute('data-lang');
            if (lang === currentLang) {
              btn.style.backgroundColor = '#00d4ff';
              btn.style.color = '#0a0a0c';
            } else {
              btn.style.backgroundColor = 'transparent';
              btn.style.color = '#64748b';
            }

            btn.addEventListener('click', (e) => {
              e.stopPropagation();
              localStorage.setItem('site-language', lang);
              location.reload();
            });
          });

          // Mobile Menu Logic
          const button = document.getElementById('mobile-menu-button');
          const menu = document.getElementById('mobile-menu');
          if (!button || !menu) return;

          const openIcon = button.querySelector('.menu-open-icon');
          const closeIcon = button.querySelector('.menu-close-icon');

          function setMenuOpen(isOpen) {
            button.setAttribute('aria-expanded', String(isOpen));
            menu.classList.toggle('hidden', !isOpen);
            openIcon?.classList.toggle('hidden', isOpen);
            closeIcon?.classList.toggle('hidden', !isOpen);
          }

          button.addEventListener('click', () => {
            setMenuOpen(button.getAttribute('aria-expanded') !== 'true');
          });

          menu.querySelectorAll('.mobile-menu-link').forEach((link) => {
            link.addEventListener('click', () => setMenuOpen(false));
          });

          window.addEventListener('resize', () => {
            if (window.innerWidth >= 768) setMenuOpen(false);
          });
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSdrxNav);
        } else {
          initSdrxNav();
        }
      </script>
  </nav>

  <main class="min-h-screen relative pb-20 pt-24 md:pt-28 overflow-x-hidden">
    <!-- Header / Bio -->
    <section class="pt-10 md:pt-20 pb-20 px-4 relative">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
          <div class="flex-1">
            <div class="mb-8 p-1 w-fit bg-gradient-to-tr from-sdrx-sky via-sdrx-purple to-sdrx-red rounded-3xl rotate-2 shadow-2xl shadow-sdrx-purple/20">
                <img src="/assets/sdrx-dots/logo-sdrx.png" alt="SDRX Logo" class="w-32 h-32 object-cover rounded-[1.4rem] -rotate-2" />
            </div>
            <h1 class="text-6xl md:text-8xl font-black mb-6 tracking-tighter bg-clip-text text-transparent bg-gradient-to-b from-white to-sdrx-purple">
                SDRX
            </h1>
            
            <p class="text-slate-300 text-xl md:text-2xl leading-relaxed max-w-3xl mb-10">
                Soy <span class="text-white font-bold tracking-tight">Sadrach Juan Diego Garcia Flores</span> tengo <span class="text-sdrx-purple font-mono font-bold inline-block min-w-[12ch]" id="age-counter">20.00000000</span>, <span class="text-sdrx-purple italic font-bold">Ingeniero en software multiplataforma</span>.
            </p>
            
