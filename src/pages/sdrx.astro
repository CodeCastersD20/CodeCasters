            <!-- Gaming -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3 text-sdrx-sky">
                    <span class="w-1.5 h-6 bg-sdrx-sky rounded-full shadow-[0_0_10px_rgba(0,212,255,0.5)]"></span>
                    Campo de Batalla
                </h3>
                <div class="space-y-3">
                    {games.map(g => (
                        <div class="flex items-center justify-center md:justify-start gap-3 p-2.5 group hover:bg-white/5 rounded-2xl transition-all border border-transparent hover:border-white/5">
                            <div class="w-2 h-2 rounded-full bg-slate-700 group-hover:bg-sdrx-sky transition-colors"></div>
                            <span class="text-slate-300 text-sm font-bold tracking-tight">{g}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Music -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3 text-sdrx-red">
                    <span class="w-1.5 h-6 bg-sdrx-red rounded-full shadow-[0_0_10px_rgba(255,49,49,0.5)]"></span>
                    Frecuencias
                </h3>
                <a href={playlistUrl} target="_blank" class="mb-10 block p-6 bg-sdrx-red/5 border border-sdrx-red/20 rounded-[2rem] hover:bg-sdrx-red/10 hover:border-sdrx-red/40 transition-all text-left relative overflow-hidden group">
                    <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-sdrx-red/10 blur-2xl group-hover:bg-sdrx-red/20 transition-all"></div>
                    <p class="text-[10px] font-black text-sdrx-red uppercase tracking-[0.3em] mb-2">Mi Playlist Principal</p>
                    <p class="text-white text-base font-bold font-mono truncate">Backend Developer</p>
                    <p class="text-[10px] text-slate-500 mt-1">youtube.com/playlist...</p>
                </a>
                <p class="text-[10px] text-slate-500 italic uppercase tracking-[0.25em] font-mono animate-pulse text-center md:text-left">Sintonizando favoritos_</p>
            </div>
        </div>
    </section>

    <!-- Blog (Vacío) -->
    {blogPosts.length > 0 && (
        <section class="py-24 px-4">
            <div class="max-w-4xl mx-auto text-center md:text-left">
                <h2 id="bitacora-title" class="text-3xl font-bold mb-12 font-mono text-sdrx-purple cursor-pointer hover:opacity-75 transition-opacity" title="...">&gt; BITACORA_</h2>
                <div id="secret-post-container" class="opacity-0 invisible transition-all duration-500 mb-8"></div>
                <div class="space-y-8">
                    {blogPosts.map(post => (
                        <article class="p-8 bg-white/5 border border-white/10 rounded-[2rem] hover:border-sdrx-purple/30 transition-all group">
                            <time class="text-xs font-mono text-sdrx-purple mb-2 block">{post.date}</time>
                            <h3 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors">{post.title}</h3>
                            <p class="text-slate-400 text-sm mb-6 leading-relaxed whitespace-pre-wrap">{post.snippet}</p>
                            <a href="#" class="text-xs font-black uppercase tracking-widest text-sdrx-sky hover:underline">Seguir leyendo_</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- Contact & Footer -->
    <section class="py-24 px-4 bg-gradient-to-t from-sdrx-purple/5 to-transparent border-t border-white/5">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-black mb-12 tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-white via-sdrx-purple to-sdrx-red">¿NECESITAS UN DESARROLLO DE CÓDIGO?</h2>
            <div class="inline-flex flex-col md:flex-row items-stretch md:items-center gap-6 p-1 bg-gradient-to-r from-sdrx-sky/20 via-sdrx-purple/20 to-sdrx-red/20 rounded-[3rem] mb-12 shadow-2xl">
                <div class="flex flex-col items-center md:items-start p-8 bg-black rounded-[2.8rem] h-full overflow-hidden">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.4em]">Direct_Access</p>
                    <a href={`mailto:${CONTACT_EMAIL}`} class="text-lg md:text-xl font-black text-sdrx-sky hover:text-white transition-colors truncate max-w-[260px] md:max-w-none">{CONTACT_EMAIL}</a>
                </div>
                <div class="flex flex-col items-center md:items-start p-8 bg-black rounded-[2.8rem] h-full">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.4em]">Discord_Node</p>
                    <span class="text-lg md:text-xl font-black text-sdrx-purple">{DISCORD_USERNAME}</span>
                </div>
            </div>
            <p class="text-slate-600 font-mono text-[10px] uppercase tracking-[0.6em] mt-12">SDRX © 2026 — DIGITAL RUNTIME EXPERIENCE</p>
        </div>
    </section>
  </main>
</SDRXLayout>

<script is:inline>
    function copyClone() {
        const cmd = "git clone https://github.com/Sadrach34/SDRX-Dots.git";
        navigator.clipboard.writeText(cmd);
        const icon = document.getElementById('copy-icon');
        const originalSvg = icon.innerHTML;
        icon.innerHTML = '<path d="M20 6L9 17l-5-5"></path>';
        setTimeout(() => {
            icon.innerHTML = originalSvg;
        }, 2000);
    }

    const birthDate = new Date('2005-08-20T00:00:00');
    function updateAge() {
        const now = new Date();
        const diff = now - birthDate;
        const age = diff / (1000 * 60 * 60 * 24 * 365.25);
        const counter = document.getElementById('age-counter');
        if (counter) {
            counter.innerText = age.toFixed(9);
        }
    }

    async function fetchSteamGame() {
        try {
            const response = await fetch('/api/steam');
            const data = await response.json();

            const steamEl = document.getElementById('steam-status');
            if (steamEl) {
                if (data.gameName) {
                    steamEl.innerHTML = `<span class="text-xs text-sdrx-sky font-bold tracking-wider">🎮 Jugando</span><p class="text-sm text-sdrx-purple font-bold">${data.gameName}</p>`;
                } else {
                    steamEl.innerHTML = `<span class="text-xs text-slate-400">No detectado / Offline</span>`;
                }
            }
        } catch (error) {
            console.error('Steam fetch error:', error);
        }
    }

    function updateTime() {
        const hmoTime = new Intl.DateTimeFormat('es-MX', {
            timeZone: 'America/Hermosillo',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        }).format(new Date());

        const timeEl = document.getElementById('hermosillo-time');
        if (timeEl) timeEl.innerText = hmoTime;

        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Hermosillo',
            hour: 'numeric',
            minute: 'numeric',
            hour12: false
        });
        const parts = formatter.formatToParts(now);
        const hour = parseInt(parts.find(p => p.type === 'hour').value);
        const minute = parseInt(parts.find(p => p.type === 'minute').value);
        const decimalHour = hour + (minute / 60);

        let task = "Descansando_";
        if (decimalHour >= 7 && decimalHour < 8.5) task = "Despertando & Café_";
        else if (decimalHour >= 8.5 && decimalHour < 9) task = "En camino al trabajo_";
        else if (decimalHour >= 9 && decimalHour < 17) task = "Trabajando en KNGURA_";
        else if (decimalHour >= 17 && decimalHour < 18) task = "Llegando a base & Relax_";
        else if (decimalHour >= 18 && decimalHour < 20) task = "Estudiando Sistemas_";
        else if (decimalHour >= 20 && decimalHour < 22.5) task = "Ocio & Gaming_";
        else task = "Recargando_ (Sleeping)";

        const taskEl = document.getElementById('current-task');
        if (taskEl) taskEl.innerText = task;

        fetchSteamGame();
    }

    setInterval(updateAge, 50);
    setInterval(updateTime, 1000);
    updateAge();
    updateTime();

    let lightboxOpen = false;
    function openLightbox(src, title) {
        const lightbox = document.getElementById('lightbox');
        const img = document.getElementById('lightbox-img');
        const titleEl = document.getElementById('lightbox-title');
        const content = document.getElementById('lightbox-content');

        img.src = src;
        titleEl.innerText = title;
        lightboxOpen = true;

        lightbox.classList.remove('opacity-0', 'invisible');
        setTimeout(() => {
            content.classList.remove('scale-75', 'opacity-0');
        }, 10);

        window.addEventListener('scroll', handleScroll);
    }

    function closeLightbox(event) {
        if (event && event.target.id !== 'lightbox') return;

        const lightbox = document.getElementById('lightbox');
        const content = document.getElementById('lightbox-content');

        content.classList.add('scale-75', 'opacity-0');
        setTimeout(() => {
            lightbox.classList.add('opacity-0', 'invisible');
            lightboxOpen = false;
            window.removeEventListener('scroll', handleScroll);
        }, 300);
    }

    function handleScroll() {
        if (lightboxOpen) {
            closeLightbox();
        }
    }

    let bitacoraClicks = 0;
    const bitacoraTitle = document.getElementById('bitacora-title');
    const secretPostContainer = document.getElementById('secret-post-container');
    const blogSection = document.querySelector('[class*="py-24 px-4"] .space-y-8');

    bitacoraTitle?.addEventListener('click', () => {
        bitacoraClicks++;

        if (bitacoraClicks <= 2 && bitacoraClicks >= 1) {
            bitacoraTitle.classList.add('glitch-light');
            setTimeout(() => bitacoraTitle.classList.remove('glitch-light'), 400);
        } else if (bitacoraClicks > 2 && bitacoraClicks <= 5) {
            bitacoraTitle.classList.add('glitch-medium');
            setTimeout(() => bitacoraTitle.classList.remove('glitch-medium'), 400);
        } else if (bitacoraClicks > 5 && bitacoraClicks <= 10) {
            bitacoraTitle.classList.add('glitch-heavy');

            if (bitacoraClicks === 10) {
                if (blogSection) blogSection.classList.add('corrupted-posts');

                setTimeout(() => {
                    secretPostContainer.innerHTML = `
                        <article class="p-8 bg-gradient-to-br from-sdrx-red/30 to-sdrx-purple/30 border-2 border-sdrx-red rounded-[2rem] group shadow-2xl shadow-sdrx-red/30 glitch-post">
                            <time class="text-xs font-mono text-sdrx-red mb-2 block glitch-text">${new Date().toISOString().split('T')[0]}</time>
                            <h3 class="text-2xl font-bold mb-4 font-mono glitch-text text-sdrx-red">///SISTEMA.CORROMPIDO///</h3>
                            <p class="text-slate-300 text-sm mb-6 leading-relaxed whitespace-pre-wrap font-mono glitch-text">encontraste algo que no debías ver. o tal vez lo que debías ver todo el tiempo. la verdad es relativa. los secretos son apenas ilusiones esperando a ser descubiertos. ¿qué es la realidad sino un conjunto de perspectivas?\n\n//ERROR_404_CONSCIOUSNESS.exe\n//status: ONLINE\n//warning: irreversible\n//access_granted: TRUE</p>
                        </article>
                    `;
                    secretPostContainer.classList.remove('opacity-0', 'invisible');
                    secretPostContainer.classList.add('glitch-post');
                    bitacoraClicks = 0;
                }, 300);
            }
        }
    });

    const style = document.createElement('style');
    style.textContent = `
        @keyframes glitch-light {
            0%, 100% { transform: translate(0); }
            25% { transform: translate(-1px, 1px); }
            50% { transform: translate(1px, -1px); }
            75% { transform: translate(-1px, -1px); }
        }

        @keyframes glitch-medium {
            0%, 100% { transform: translate(0); }
            10% { transform: translate(-3px, 3px); }
            20% { transform: translate(3px, -3px); }
            30% { transform: translate(-3px, -3px); }
            40% { transform: translate(3px, 3px); }
            50% { transform: translate(-2px, 2px); }
            60% { transform: translate(2px, -2px); }
            70% { transform: translate(-2px, -2px); }
            80% { transform: translate(2px, 2px); }
        }

        @keyframes glitch-heavy {
            0%, 100% { transform: translate(0) skewX(0); }
            5% { transform: translate(-5px, 5px) skewX(-2deg); }
            10% { transform: translate(5px, -5px) skewX(2deg); }
            15% { transform: translate(-5px, -5px) skewX(-2deg); }
            20% { transform: translate(5px, 5px) skewX(2deg); }
            25% { transform: translate(-3px, 3px) skewX(-1deg); }
            30% { transform: translate(3px, -3px) skewX(1deg); }
            35% { transform: translate(-4px, 4px) skewX(-2deg); }
            40% { transform: translate(4px, -4px) skewX(2deg); }
            45% { transform: translate(-2px, 2px) skewX(-1deg); }
            50% { transform: translate(2px, -2px) skewX(1deg); }
            55% { transform: translate(-3px, 3px) skewX(-2deg); }
            60% { transform: translate(3px, -3px) skewX(2deg); }
            65% { transform: translate(-1px, 1px) skewX(-1deg); }
            70% { transform: translate(1px, -1px) skewX(1deg); }
            75% { transform: translate(-4px, 4px) skewX(-2deg); }
            80% { transform: translate(4px, -4px) skewX(2deg); }
            85% { transform: translate(-2px, 2px) skewX(-1deg); }
            90% { transform: translate(2px, -2px) skewX(1deg); }
            95% { transform: translate(-1px, 1px) skewX(-1deg); }
        }

        #bitacora-title.glitch-light {
            animation: glitch-light 0.4s ease-in-out;
            color: #fca5a5;
            text-shadow: 1px 0 #a855f7, -1px 0 #00d4ff;
        }

        #bitacora-title.glitch-medium {
            animation: glitch-medium 0.4s ease-in-out;
            color: #ef4444;
            text-shadow: 2px 0 #a855f7, -2px 0 #00d4ff, 4px 0 #fca5a5;
        }

        #bitacora-title.glitch-heavy {
            animation: glitch-heavy 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
            color: #dc2626;
            text-shadow: 3px 0 #a855f7, -3px 0 #00d4ff, 6px 0 #fca5a5, -6px 0 #ec4899;
            filter: saturate(1.5) brightness(1.2);
        }

        .corrupted-posts > article {
            animation: data-corrupt 0.5s ease-out forwards;
            opacity: 0.3;
            filter: blur(2px) invert(0.1);
            pointer-events: none;
        }

        @keyframes data-corrupt {
            0% { transform: translateX(0) scaleY(1); opacity: 1; }
            50% { transform: translateX(-10px) scaleY(0.95); opacity: 0.5; }
            100% { transform: translateX(0) scaleY(1); opacity: 0.3; filter: blur(2px) invert(0.1); }
        }

        #secret-post-container.glitch-post {
            animation: secret-appear 0.8s cubic-bezier(0.68, -0.55, 0.265, 1.55) forwards;
        }

        @keyframes secret-appear {
            0% {
                opacity: 0;
                transform: scale(0.5) rotate(-5deg);
                filter: blur(10px);
            }
            50% {
                filter: blur(5px) brightness(1.5);
            }
            100% {
                opacity: 1;
                transform: scale(1) rotate(0deg);
                filter: blur(0);
            }
        }

        .glitch-text {
            animation: glitch-text 2s infinite;
            font-weight: bold;
        }

        @keyframes glitch-text {
            0%, 100% { text-shadow: 0 0 0 transparent; }
            50% { text-shadow: 2px 0 #00d4ff, -2px 0 #a855f7; }
        }
    `;
    document.head.appendChild(style);
</script>
