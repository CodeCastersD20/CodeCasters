---
import SDRXLayout from '../layouts/SDRXLayout.astro';

const birthDate = new Date('2005-08-20T00:00:00');

const projects = [
  {
    title: "SDRX-pax",
    desc: "Instalador de paquetes interactivo en TUI para Arch Linux. Combina pacman y yay (AUR) en una única interfaz fzf ultrarrápida. Carga en <50ms usando Smart Caching.",
    tech: ["Rust", "fzf", "Pacman", "Yay"],
    link: "https://github.com/Sadrach34/SDRX-pax",
    color: "sdrx-sky"
  },
  {
    title: "SDRX-Beat",
    desc: "Reproductor de música para terminal (TUI) basado en mpv. Soporta archivos locales y streaming de YouTube/radio por internet sin interfaz gráfica. Gestión de sesiones y descargas integradas.",
    tech: ["Python", "mpv", "yt-dlp", "Curses"],
    link: "https://github.com/Sadrach34/SDRX-Beat",
    color: "sdrx-purple"
  }
];

const screenshots = [
  { src: "/assets/sdrx-dots/desktop-main.png", title: "Main Desktop" },
  { src: "/assets/sdrx-dots/dashboard.png", title: "Dashboard" },
  { src: "/assets/sdrx-dots/app_launcher.png", title: "App Launcher" },
  { src: "/assets/sdrx-dots/wallpaper-picker.png", title: "Wallpaper Picker" }
];

const socialLinks = [
  { name: "GitHub", url: "https://github.com/Sadrach34", color: "sdrx-sky" },
  { name: "Discord", url: "https://discord.com", username: "sadrach34", color: "sdrx-purple" },
  { name: "Instagram", url: "https://www.instagram.com/sadrach345/", color: "sdrx-red" },
  { name: "YouTube", url: "https://youtube.com", color: "sdrx-red" },
  { name: "Reddit", url: "https://reddit.com", color: "orange-500" }
];

const games = ["Elden Ring", "Warframe", "Balatro", "The Binding of Isaac", "Minecraft", "Dungeons & Dragons"];
const hyperfixations = ["Arch Linux", "Hyprland", "TUI", "Web Development", "Musica", "Programación"];
const playlistUrl = "https://youtube.com/playlist?list=PLXuOK4h_ZtSbGV1FsT_nC0TRlf2EmwXEE&si=a_KVNAgiHmzAiMlM";

const blogPosts = []; // Vacío por ahora
---

<SDRXLayout title="SDRX | Digital Runtime Experience">
  <main class="min-h-screen relative pb-20 overflow-x-hidden">
    <!-- Navbar -->
    <nav class="p-6 flex flex-col sm:flex-row justify-between items-center max-w-7xl mx-auto relative z-10 gap-4">
      <a href="/" class="text-sm font-mono text-slate-500 hover:text-sdrx-sky transition-colors flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        Volver a CodeCasters
      </a>
      <div class="px-4 py-1 bg-white/5 border border-white/10 rounded-full text-xs font-mono text-sdrx-sky">
        v1.6.0-stable
      </div>
    </nav>

    <!-- Header / Bio -->
    <section class="pt-10 md:pt-20 pb-20 px-4 relative">
      <div class="max-w-6xl mx-auto">
        <div class="flex flex-col lg:flex-row gap-16 items-start">
          <div class="flex-1">
            <div class="mb-8 p-1 w-fit bg-gradient-to-tr from-sdrx-sky via-sdrx-purple to-sdrx-red rounded-3xl rotate-2 shadow-2xl shadow-sdrx-purple/40">
                <img src="/assets/sdrx-dots/logo-sdrx.png" alt="SDRX Logo" class="w-32 h-32 object-cover rounded-[1.4rem] -rotate-2" />
            </div>
            <h1 class="text-6xl md:text-8xl font-black mb-6 tracking-tighter bg-clip-text text-transparent bg-gradient-to-b from-white to-sdrx-purple">
                SDRX
            </h1>
            
            <p class="text-slate-300 text-xl md:text-2xl leading-relaxed max-w-3xl mb-10">
                Soy <span class="text-white font-bold tracking-tight">Sadrach Juan Diego Garcia Flores</span>, tengo <span class="text-sdrx-purple font-mono font-bold inline-block min-w-[12ch]" id="age-counter">20.00000000</span> años e <span class="text-sdrx-purple italic font-bold">Ingeniero en software multiplataforma</span>.
            </p>
            
            <div class="flex flex-wrap gap-4">
                {socialLinks.map(s => (
                    <a href={s.url} target="_blank" class={`px-4 py-2 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-purple/50 hover:bg-sdrx-purple/10 transition-all text-xs font-mono uppercase tracking-widest text-slate-400 hover:text-white`}>
                        {s.name}
                    </a>
                ))}
            </div>
          </div>

          <!-- Status Board -->
          <div class="w-full lg:w-80 space-y-6">
            <div class="p-6 bg-white/5 border border-white/10 rounded-3xl relative overflow-hidden group">
                <div class="absolute top-0 right-0 p-2">
                    <div class="w-2 h-2 rounded-full bg-sdrx-sky animate-pulse"></div>
                </div>
                <h3 class="text-xs font-black text-slate-500 uppercase tracking-widest mb-4">En_Línea_Status</h3>
                <div class="mb-4 text-center lg:text-left">
                    <p class="text-2xl font-bold text-white font-mono" id="hermosillo-time">00:00:00</p>
                    <p class="text-[10px] text-slate-500 font-mono italic">Hermosillo, MX</p>
                </div>
                <div class="p-3 bg-black/40 rounded-xl border border-white/5">
                    <p class="text-[10px] text-slate-400 mb-1 font-mono uppercase">Haciendo ahora:</p>
                    <p class="text-sm font-bold text-sdrx-sky" id="current-task">Procesando_...</p>
                </div>
                <div class="mt-4 pt-4 border-t border-white/5">
                    <p class="text-[10px] text-slate-500 uppercase font-bold">Discord</p>
                    <p class="text-sm text-slate-300">@sadrach34</p>
                </div>
            </div>

            <div class="p-6 bg-gradient-to-br from-sdrx-purple/10 to-transparent border border-sdrx-purple/20 rounded-3xl group">
                <h3 class="text-[10px] font-black text-sdrx-purple uppercase tracking-widest mb-4 flex items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M6 3h12l4 18H2z"/></svg>
                    Steam_Session
                </h3>
                <p class="text-xs text-slate-400 italic">Integrando API de Steam...</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- SDRX-dots Spotlight -->
    <section class="py-10 md:py-24 px-4 relative z-10 bg-white/[0.01] border-y border-white/5 shadow-[inset_0_0_50px_rgba(188,19,254,0.05)]">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-5 gap-12 items-center mb-20">
          <div class="lg:col-span-2 text-center lg:text-left">
            <h2 class="text-4xl md:text-5xl font-extrabold mb-6 text-white tracking-tight">SDRX-dots</h2>
            <div class="h-1.5 w-24 bg-gradient-to-r from-sdrx-sky via-sdrx-purple to-sdrx-red mb-8 mx-auto lg:mx-0 rounded-full"></div>
            <p class="text-slate-400 leading-relaxed mb-10 text-base md:text-lg italic">
              "Mi entorno de escritorio definitivo. Un ecosistema visualmente impactante construido sobre <strong>Arch Linux</strong> y <strong>Hyprland</strong>."
            </p>
            
            <div class="grid grid-cols-2 gap-4 mb-10 text-left">
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-sky/30 transition-colors group">
                    <h4 class="text-sdrx-sky font-bold text-[10px] uppercase mb-1">Gestor</h4>
                    <p class="text-slate-300 text-sm">Hyprland</p>
                </div>
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-purple/30 transition-colors group">
                    <h4 class="text-sdrx-purple font-bold text-[10px] uppercase mb-1">Barra</h4>
                    <p class="text-slate-300 text-sm">Waybar</p>
                </div>
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-sdrx-red/30 transition-colors group">
                    <h4 class="text-sdrx-red font-bold text-[10px] uppercase mb-1">Widgets</h4>
                    <p class="text-slate-300 text-sm">Quickshell</p>
                </div>
                <div class="p-4 bg-white/5 border border-white/10 rounded-xl hover:border-white/30 transition-colors group">
                    <h4 class="text-slate-400 font-bold text-[10px] uppercase mb-1">Terminal</h4>
                    <p class="text-slate-300 text-sm font-mono tracking-tighter">Kitty + Zsh</p>
                </div>
            </div>

            <div class="flex flex-col gap-4 max-w-sm mx-auto lg:mx-0">
                <div class="flex items-center gap-2 p-2 bg-black border border-white/10 rounded-xl">
                    <code class="text-[10px] text-sdrx-purple flex-1 px-2 overflow-x-auto whitespace-nowrap scrollbar-hide" id="clone-cmd">git clone https://github.com/Sadrach34/SDRX-Dots.git</code>
                    <button class="p-2 hover:bg-white/10 rounded-lg transition-colors group" onclick="copyClone()" title="Copiar comando">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" id="copy-icon" class="text-sdrx-sky"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path></svg>
                    </button>
                </div>
                <a href="https://github.com/Sadrach34/SDRX-Dots" target="_blank" class="inline-flex items-center justify-center gap-4 px-8 py-4 bg-sdrx-purple text-white font-black rounded-2xl hover:bg-white hover:text-black transition-all transform hover:-translate-y-1 shadow-lg shadow-sdrx-purple/20">
                    CLONAR DOTFILES
                    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
                </a>
                <p class="text-[10px] text-slate-500 text-center font-mono uppercase tracking-[0.2em]">Dále una ★ en GitHub si te gusta_</p>
            </div>
          </div>
          
          <div class="lg:col-span-3 grid grid-cols-2 gap-4">
             {screenshots.map((s, i) => (
                <div class={`group relative aspect-video bg-white/5 border border-white/10 rounded-2xl overflow-hidden shadow-2xl ${i === 1 ? 'mt-8' : i === 2 ? '-mt-8' : ''}`}>
                    <img src={s.src} alt={s.title} class="w-full h-full object-cover opacity-60 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700" />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end p-4">
                        <span class="text-xs font-mono text-sdrx-purple font-bold tracking-widest">{s.title}</span>
                    </div>
                </div>
             ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Terminal Projects (TUI) -->
    <section class="py-24 px-4 relative z-10">
      <div class="max-w-6xl mx-auto">
        <div class="mb-16 text-center lg:text-left flex flex-col lg:flex-row justify-between items-end gap-6">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold mb-4 text-white">Forjas de Terminal</h2>
            <p class="text-slate-400 max-w-2xl text-lg font-medium">Utilerías diseñadas para la eficiencia pura. Rendimiento y control total sobre el núcleo.</p>
          </div>
          <div class="p-5 bg-sdrx-purple/10 border border-sdrx-purple/20 rounded-[1.5rem] text-xs text-sdrx-purple font-bold font-mono tracking-wider italic">
            &gt; ¿Quieres contribuir? Abre un PR en GitHub_
          </div>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          {projects.map(p => (
            <div class="group bg-black border border-white/10 hover:border-sdrx-purple/40 rounded-[2rem] p-8 transition-all relative overflow-hidden flex flex-col justify-between shadow-2xl">
              <div class={`absolute top-0 right-0 w-40 h-40 opacity-0 group-hover:opacity-20 blur-3xl transition-opacity rounded-full bg-${p.color}`}></div>
              <div>
                <h3 class="text-2xl font-bold text-white mb-4 group-hover:text-sdrx-purple transition-colors font-mono">{p.title}</h3>
                <p class="text-slate-400 text-sm leading-relaxed mb-8">
                  {p.desc}
                </p>
                <div class="flex flex-wrap gap-2 mb-8">
                  {p.tech.map(t => (
                    <span class="text-[10px] uppercase tracking-widest font-bold px-3 py-1 bg-white/5 text-slate-300 border border-white/10 rounded-full">
                      {t}
                    </span>
                  ))}
                </div>
              </div>
              <a href={p.link} target="_blank" class="inline-flex items-center gap-2 text-sm font-bold text-white hover:text-sdrx-purple transition-colors group">
                Explorar Código
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="transition-transform group-hover:translate-x-1"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Personal Grids -->
    <section class="py-24 px-4 bg-white/[0.01] border-y border-white/5">
        <div class="max-w-6xl mx-auto grid md:grid-cols-3 gap-12 text-center md:text-left">
            <!-- Hyperfixations -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3">
                    <span class="w-1.5 h-6 bg-sdrx-purple rounded-full shadow-[0_0_10px_rgba(188,19,254,0.5)]"></span>
                    Hiperfijaciones
                </h3>
                <ul class="grid grid-cols-2 md:grid-cols-1 gap-3">
                    {hyperfixations.map(h => (
                        <li class="p-3 bg-white/5 border border-white/5 rounded-xl text-slate-300 text-[11px] uppercase tracking-widest font-black hover:border-sdrx-purple/50 hover:bg-sdrx-purple/5 transition-all cursor-default">
                            {h}
                        </li>
                    ))}
                </ul>
            </div>

            <!-- Gaming -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3 text-sdrx-sky">
                    <span class="w-1.5 h-6 bg-sdrx-sky rounded-full shadow-[0_0_10px_rgba(0,212,255,0.5)]"></span>
                    Campo de Batalla
                </h3>
                <div class="space-y-3">
                    {games.map(g => (
                        <div class="flex items-center justify-center md:justify-start gap-3 p-2.5 group hover:bg-white/5 rounded-2xl transition-all border border-transparent hover:border-white/5">
                            <div class="w-2 h-2 rounded-full bg-slate-700 group-hover:bg-sdrx-sky transition-colors"></div>
                            <span class="text-slate-300 text-sm font-bold tracking-tight">{g}</span>
                        </div>
                    ))}
                </div>
            </div>

            <!-- Music -->
            <div>
                <h3 class="text-xl font-bold mb-8 flex items-center justify-center md:justify-start gap-3 text-sdrx-red">
                    <span class="w-1.5 h-6 bg-sdrx-red rounded-full shadow-[0_0_10px_rgba(255,49,49,0.5)]"></span>
                    Frecuencias
                </h3>
                <a href={playlistUrl} target="_blank" class="mb-10 block p-6 bg-sdrx-red/5 border border-sdrx-red/20 rounded-[2rem] hover:bg-sdrx-red/10 hover:border-sdrx-red/40 transition-all text-left relative overflow-hidden group">
                    <div class="absolute -right-4 -bottom-4 w-24 h-24 bg-sdrx-red/10 blur-2xl group-hover:bg-sdrx-red/20 transition-all"></div>
                    <p class="text-[10px] font-black text-sdrx-red uppercase tracking-[0.3em] mb-2">Mi Playlist Principal</p>
                    <p class="text-white text-base font-bold font-mono truncate">Cyber-Rhythms v.1.0</p>
                    <p class="text-[10px] text-slate-500 mt-1">youtube.com/playlist...</p>
                </a>
                <p class="text-[10px] text-slate-500 italic uppercase tracking-[0.25em] font-mono animate-pulse">Sintonizando favoritos_</p>
            </div>
        </div>
    </section>

    <!-- Blog (Vacío) -->
    {blogPosts.length > 0 && (
        <section class="py-24 px-4">
            <div class="max-w-4xl mx-auto">
                <h2 class="text-3xl font-bold mb-12 text-center font-mono text-sdrx-purple">&gt; BITACORA_</h2>
                <div class="space-y-8">
                    {blogPosts.map(post => (
                        <article class="p-8 bg-white/5 border border-white/10 rounded-[2rem] hover:border-sdrx-purple/30 transition-all group">
                            <time class="text-xs font-mono text-sdrx-purple mb-2 block">{post.date}</time>
                            <h3 class="text-2xl font-bold mb-4 group-hover:text-white transition-colors">{post.title}</h3>
                            <p class="text-slate-400 text-sm mb-6 leading-relaxed">{post.snippet}</p>
                            <a href="#" class="text-xs font-black uppercase tracking-widest text-sdrx-sky hover:underline">Seguir leyendo_</a>
                        </article>
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- Contact & Footer -->
    <section class="py-24 px-4 bg-gradient-to-t from-sdrx-purple/5 to-transparent border-t border-white/5">
        <div class="max-w-4xl mx-auto text-center">
            <h2 class="text-4xl font-black mb-12 tracking-tighter bg-clip-text text-transparent bg-gradient-to-r from-white via-sdrx-purple to-sdrx-red">¿NECESITAS UN HECHIZO DE CÓDIGO?</h2>
            <div class="inline-flex flex-col md:flex-row items-stretch md:items-center gap-6 p-1 bg-gradient-to-r from-sdrx-sky/20 via-sdrx-purple/20 to-sdrx-red/20 rounded-[3rem] mb-12 shadow-2xl">
                <div class="flex flex-col items-center md:items-start p-8 bg-black rounded-[2.8rem] h-full">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.4em]">Direct_Access</p>
                    <a href="mailto:jdiego0805+dev@gmail.com" class="text-lg md:text-xl font-black text-sdrx-sky hover:text-white transition-colors truncate max-w-[280px]">jdiego0805+dev@gmail.com</a>
                </div>
                <div class="flex flex-col items-center md:items-start p-8 bg-black rounded-[2.8rem] h-full">
                    <p class="text-slate-500 mb-2 font-mono text-[10px] uppercase tracking-[0.4em]">Discord_Node</p>
                    <span class="text-lg md:text-xl font-black text-sdrx-purple">sadrach34</span>
                </div>
            </div>
            <p class="text-slate-600 font-mono text-[10px] uppercase tracking-[0.6em] mt-12">SDRX © 2026 — DIGITAL RUNTIME EXPERIENCE</p>
        </div>
    </section>
  </main>
</SDRXLayout>

<script is:inline>
    function copyClone() {
        const cmd = "git clone https://github.com/Sadrach34/SDRX-Dots.git";
        navigator.clipboard.writeText(cmd);
        const icon = document.getElementById('copy-icon');
        const originalSvg = icon.innerHTML;
        icon.innerHTML = '<path d="M20 6L9 17l-5-5"></path>';
        setTimeout(() => {
            icon.innerHTML = originalSvg;
        }, 2000);
    }

    const birthDate = new Date('2005-08-20T00:00:00');
    function updateAge() {
        const now = new Date();
        const diff = now - birthDate;
        const age = diff / (1000 * 60 * 60 * 24 * 365.25);
        const counter = document.getElementById('age-counter');
        if (counter) {
            counter.innerText = age.toFixed(9);
        }
    }

    function updateTime() {
        const hmoTime = new Intl.DateTimeFormat('es-MX', {
            timeZone: 'America/Hermosillo',
            hour: '2-digit',
            minute: '2-digit',
            second: '2-digit',
            hour12: false
        }).format(new Date());
        
        const timeEl = document.getElementById('hermosillo-time');
        if (timeEl) timeEl.innerText = hmoTime;

        const now = new Date();
        const formatter = new Intl.DateTimeFormat('en-US', {
            timeZone: 'America/Hermosillo',
            hour: 'numeric',
            minute: 'numeric',
            hour12: false
        });
        const parts = formatter.formatToParts(now);
        const hour = parseInt(parts.find(p => p.type === 'hour').value);
        const minute = parseInt(parts.find(p => p.type === 'minute').value);
        const decimalHour = hour + (minute / 60);
        
        let task = "Descansando_";
        if (decimalHour >= 7 && decimalHour < 8.5) task = "Despertando & Café_";
        else if (decimalHour >= 8.5 && decimalHour < 9) task = "En camino al trabajo_";
        else if (decimalHour >= 9 && decimalHour < 17) task = "Trabajando en KNGURA_";
        else if (decimalHour >= 17 && decimalHour < 18) task = "Llegando a base & Relax_";
        else if (decimalHour >= 18 && decimalHour < 20) task = "Estudiando Arcanos_";
        else if (decimalHour >= 20 && decimalHour < 22.5) task = "Ocio & Gaming_";
        else task = "Recargando_ (Sleeping)";

        const taskEl = document.getElementById('current-task');
        if (taskEl) taskEl.innerText = task;
    }

    setInterval(updateAge, 50);
    setInterval(updateTime, 1000);
    updateAge();
    updateTime();
</script>
